# ============================================================
# Plickers School Response System — Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://plickers_user:CHANGE_ME_PASSWORD@postgres:5432/plickers_db
DATABASE_URL_SYNC=postgresql://plickers_user:CHANGE_ME_PASSWORD@postgres:5432/plickers_db

# ── JWT Authentication ─────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_use_a_long_random_secret_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Application ────────────────────────────────────────────────
APP_ENV=development
APP_NAME=Plickers School Response System
APP_VERSION=1.0.0
DEBUG=true

# ── CORS ───────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ── File Upload ────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# ── Rate Limiting ──────────────────────────────────────────────
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_GLOBAL_PER_MINUTE=300

# ── PostgreSQL (used by Docker Compose) ────────────────────────
POSTGRES_USER=plickers_user
POSTGRES_PASSWORD=CHANGE_ME_PASSWORD
POSTGRES_DB=plickers_db

# ── pgAdmin (optional, for development) ────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@plickers.dev
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_pgadmin

# ── Logging ────────────────────────────────────────────────────
LOG_LEVEL=INFO
